</style>

<script>
  const path = document.getElementById("hero-route-path") as SVGPathElement | null;
  const ticks = document.querySelectorAll<HTMLElement>(".hero-tick");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Baseline (no JS, or reduced motion): the path and ticks already render
  // fully visible via CSS. Only when motion is allowed do we hide the path,
  // draw it on via stroke-dashoffset, then stagger-reveal the ticks.
  if (path && !reduceMotion) {
    const length = path.getTotalLength();
    path.style.strokeDasharray = `${length}`;
    path.style.strokeDashoffset = `${length}`;
    ticks.forEach((tick) => tick.classList.add("is-pending"));

    requestAnimationFrame(() => {
      path.style.transition = "stroke-dashoffset 1800ms cubic-bezier(0.22, 1, 0.36, 1)";
      path.style.strokeDashoffset = "0";
    });

    path.addEventListener(
      "transitionend",
      () => {
        ticks.forEach((tick, i) => {
          setTimeout(() => tick.classList.remove("is-pending"), i * 160);
        });
      },
      { once: true }
    );

    // Fallback: if transitionend never fires (tab backgrounded mid-draw,
    // browser quirk), reveal anyway. classList.remove is a no-op if the
    // transitionend path already ran, so this is safe either way. Longer
    // than the last tick's natural stagger (draw 1800ms + 2 * 160ms ≈ 2136ms)
    // so it never preempts it.
    setTimeout(() => {
      ticks.forEach((tick) => tick.classList.remove("is-pending"));
    }, 2600);
  }

  // Pinned-device scrollytelling (Amendment 2026-08-22). Enhancement gate:
  // motion allowed + IntersectionObserver + position:sticky supported.
  // Everything else (no JS, reduced motion, old browsers) keeps the
  // .surfaces-fallback stacked rows fully visible via plain CSS.
  const scrollyRoot = document.querySelector<HTMLElement>(".surfaces-scrolly");
  const scrollySupported =
    !reduceMotion &&
    "IntersectionObserver" in window &&
    typeof CSS !== "undefined" &&
    CSS.supports("position", "sticky");

  if (scrollyRoot && scrollySupported) {
    document.documentElement.classList.add("scrolly-active");

    const scrollyPinned = scrollyRoot.querySelector<HTMLElement>(".scrolly-pinned");
    const blocks = Array.from(scrollyRoot.querySelectorAll<HTMLElement>(".scrolly-block"));
    const screens = Array.from(scrollyRoot.querySelectorAll<HTMLElement>(".scrolly-screen"));
    const railItems = Array.from(scrollyRoot.querySelectorAll<HTMLElement>(".rail-item"));
    const marker = scrollyRoot.querySelector<HTMLElement>(".rail-marker");
    const railLabels = scrollyRoot.querySelector<HTMLElement>(".rail-labels");

    const setActive = (surface: string) => {
      screens.forEach((el) => el.classList.toggle("is-active", el.dataset.surface === surface));
      blocks.forEach((el) => el.classList.toggle("is-active", el.dataset.surface === surface));
      railItems.forEach((el) => el.classList.toggle("is-active", el.dataset.surface === surface));

      const activeItem = railItems.find((el) => el.dataset.surface === surface);
      if (activeItem && marker && railLabels) {
        const railRect = railLabels.getBoundingClientRect();
        const itemRect = activeItem.getBoundingClientRect();
        marker.style.left = `${itemRect.left - railRect.left}px`;
        marker.style.width = `${itemRect.width}px`;
      }
    };

    // rootMargin technique: shrink the observed viewport to a thin band at
    // its vertical center, so a block is "focused" only as it crosses the
    // middle of the screen, not merely on entering/leaving the edges. The
    // observer only WAKES this up (threshold:0 fires on any block entering
    // or leaving the band) — the actual pick is a fresh recompute across all
    // blocks' live geometry, not the entries batch. entries batches only
    // include blocks whose intersection crossed the 0% boundary since the
    // last callback, so a block that stays intersecting across a big scroll
    // jump can be the correct pick without appearing in that batch at all;
    // recomputing from scratch is what makes a large jump land correctly.
    // On mobile the pinned device stacks above the copy (column layout) and
    // stays sticky at top:0, opaquely covering that same span of the
    // viewport for as long as it's stuck — a plain viewport-center band
    // would sit right underneath it, permanently hidden. When stacked, the
    // band is centered in the visible span BELOW the pinned block instead;
    // on desktop (row layout, pinned beside the copy, nothing covered) it's
    // the full viewport as before.
    const band = () => {
      const h = window.innerHeight;
      const stacked = getComputedStyle(scrollyRoot).flexDirection === "column";
      const pinnedH = stacked && scrollyPinned ? Math.min(scrollyPinned.getBoundingClientRect().height, h) : 0;
      const visibleH = h - pinnedH;
      return {
        top: pinnedH + visibleH * 0.45,
        bottom: pinnedH + visibleH * 0.55,
        center: pinnedH + visibleH / 2,
      };
    };

    const recomputeActive = () => {
      const { top: bandTop, bottom: bandBottom, center: viewportCenter } = band();
      let closest: HTMLElement | null = null;
      let closestDistance = Infinity;
      for (const block of blocks) {
        const rect = block.getBoundingClientRect();
        if (rect.bottom <= bandTop || rect.top >= bandBottom) continue;
        const distance = Math.abs(rect.top + rect.height / 2 - viewportCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = block;
        }
      }
      if (closest?.dataset.surface) setActive(closest.dataset.surface);
    };

    requestAnimationFrame(recomputeActive);

    const focusObserver = new IntersectionObserver(recomputeActive, {
      rootMargin: "-45% 0px -45% 0px",
      threshold: 0,
    });

    blocks.forEach((block) => focusObserver.observe(block));
    window.addEventListener("resize", recomputeActive);

    // Clickable rail: jump-scroll to the matching copy block, centered in
    // the viewport so it lands inside the focus band above and the
    // IntersectionObserver picks up the new state on its own.
    railItems.forEach((item) => {
      item.addEventListener("click", () => {
        const target = blocks.find((block) => block.dataset.surface === item.dataset.surface);
        target?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });
  }

  // Row entrance: same visual result everywhere via IntersectionObserver,
  // rather than only in browsers with animation-timeline: view(). Baseline
  // CSS renders rows fully visible; row-pending (hidden) is only ever added
  // here, so a script failure never leaves a blank section. Skipped when the
  // scrolly block is active: its focus-dimming replaces this row entrance,
  // and the rows it would animate are display:none anyway.
  const rows = document.querySelectorAll<HTMLElement>(".surface-row");
  if (rows.length && !reduceMotion && !scrollySupported) {
    rows.forEach((row) => row.classList.add("row-pending"));

    const observer = new IntersectionObserver(
      (entries) => {
        entries
          .filter((entry) => entry.isIntersecting)
          .forEach((entry, i) => {
            const row = entry.target as HTMLElement;
            observer.unobserve(row);
            setTimeout(() => {
              row.classList.remove("row-pending");
              row.classList.add("is-in");
            }, i * 90);
          });
      },
      { threshold: 0.2 }
    );

    rows.forEach((row) => observer.observe(row));
  }
</script>

<style>
  .hero-tick.is-pending {
    opacity: 0;
    transform: scale(0.6);
  }
</style>
