    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    padding-block: 72px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
    text-align: center;
  }

