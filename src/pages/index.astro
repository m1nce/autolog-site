---
import Base from "../layouts/Base.astro";
import { withBase } from "../lib/base";
import route from "../assets/hero-route.json";

import heroLive from "../assets/screens/hero-live.webp";
import surfaceLive from "../assets/screens/surface-live.webp";
import surfaceTrips from "../assets/screens/surface-trips.webp";
import surfaceRoads from "../assets/screens/surface-roads.webp";
import surfaceStats from "../assets/screens/surface-stats.webp";
import surfaceGarage from "../assets/screens/surface-garage.webp";

const [tickStart, tickBestMile, tickEnd] = route.ticks;

// Single source of truth for the five surface states, shared by the
// scrollytelling blocks and the .surfaces-fallback stacked rows so the two
// can never drift out of copy sync again.
const surfaces = [
  {
    surface: "live",
    eyebrow: "LIVE",
    heading: "Read it while it runs.",
    body: "RPM, throttle, coolant, and a NOW and AVG fuel register. Everything the engine is doing, while it does it.",
    image: surfaceLive,
    alt: "AutoLog Live screen with a 37 MPH speed gauge, 2,400 RPM, and NOW/AVG fuel economy registers",
  },
  {
    surface: "trips",
    eyebrow: "TRIPS",
    heading: "Every drive recorded.",
    body: "AutoLog wakes up and sleeps with your car. Every trip keeps its route, its economy, and every sample in between.",
    image: surfaceTrips,
    alt: "AutoLog Trips screen with a satellite route card and a list of drives with mileage and mpg",
  },
  {
    surface: "roads",
    eyebrow: "ROADS",
    heading: "AutoLog learns with you.",
    body: "Every road you drive joins your own map, kept by name. The more you drive, the more it knows.",
    image: surfaceRoads,
    alt: "AutoLog Roads screen showing known roads lit against a dark map",
  },
  {
    surface: "stats",
    eyebrow: "STATS",
    heading: "Every number earns its tile.",
    body: "Longest haul, best tank, total climb. Your hunches, checked against the record.",
    image: surfaceStats,
    alt: "AutoLog Stats screen: the Measured Wall, RPM histogram and lifetime records",
  },
  {
    surface: "garage",
    eyebrow: "GARAGE",
    heading: "Your car, personified.",
    body: "You love the car. Now it keeps a record of its own: the spec sheet, the odometer story, its temperament.",
    image: surfaceGarage,
    alt: "AutoLog Garage screen with the Miata's decoded spec sheet, odometer, and active fault codes",
  },
];
---

<Base
  title="AutoLog"
  description="AutoLog records every trip from the OBD2 port. Stats, roads, faults. Nothing cleared, nothing written."
>
  <section class="hero">
    <div class="hero-copy">
      <h1 class="hero-headline">The logbook your car deserves.</h1>
      <p class="hero-sub">
        See your car speak to you, live.
      </p>
      <a id="app-store" class="app-store-badge" href="#">APP STORE BADGE</a>
      <!-- TODO: TestFlight public link -->
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-trace-box">
        <svg
          class="hero-trace"
          viewBox={route.viewBox}
          preserveAspectRatio="xMidYMid meet"
          fill="none"
        >
          <path
            id="hero-route-path"
            d={route.path}
            stroke="var(--color-bone)"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
          <g class="hero-tick">
            <circle cx={tickStart.x} cy={tickStart.y} r="5"></circle>
            <text x={tickStart.x + 12} y={tickStart.y + 4} text-anchor="start"
              >{tickStart.label}</text
            >
          </g>
          <g class="hero-tick">
            <circle cx={tickBestMile.x} cy={tickBestMile.y} r="5"></circle>
            <text
              x={tickBestMile.x - 12}
              y={tickBestMile.y + 4}
              text-anchor="end">{tickBestMile.label}</text
            >
          </g>
          <g class="hero-tick">
            <circle cx={tickEnd.x} cy={tickEnd.y} r="5"></circle>
            <text x={tickEnd.x - 12} y={tickEnd.y + 4} text-anchor="end"
              >{tickEnd.label}</text
            >
          </g>
        </svg>
      </div>

      <!-- real simulator capture, seeded showcase store (2026-08-22) -->
      <img
        class="hero-device"
        src={heroLive.src}
        width={heroLive.width}
        height={heroLive.height}
        alt=""
      />
    </div>

    <p class="telemetry-strip microlabel">RPM &middot; SPEED &middot; MPG &middot; COOLANT</p>
  </section>

  <section class="privacy-strip">
    <div class="privacy-claim">
      <p class="eyebrow microlabel">PRIVACY</p>
      <p class="privacy-line">Trips stay on the phone. No account, no analytics.</p>
    </div>
    <a class="privacy-link" href={withBase("/privacy")}>Read the privacy policy</a>
  </section>

  <section class="interstitial">
    <div class="wrap interstitial-copy">
      <h2 class="interstitial-heading">Drive. Let AutoLog do the rest.</h2>
    </div>
  </section>

  <section class="surfaces">
    <!-- Pinned-device scrollytelling block (Amendment 2026-08-22). JS adds
         .scrolly-active to <html> only when motion is allowed and
         IntersectionObserver + position:sticky are supported; otherwise this
         stays display:none and .surfaces-fallback below renders instead. -->
    <div class="wrap surfaces-scrolly">
      <div class="scrolly-pinned">
        <div class="scrolly-device" aria-hidden="true">
          {surfaces.map((s, i) => (
            <img
              class={`scrolly-screen${i === 0 ? " is-active" : ""}`}
              data-surface={s.surface}
              src={s.image.src}
              width={s.image.width}
              height={s.image.height}
              alt=""
            />
          ))}
        </div>
        <div class="scrolly-rail">
          <div class="rail-labels">
            <button type="button" class="rail-item is-active" data-surface="live">LIVE</button>
            <span class="rail-dot" aria-hidden="true">&middot;</span>
            <button type="button" class="rail-item" data-surface="trips">TRIPS</button>
            <span class="rail-dot" aria-hidden="true">&middot;</span>
            <button type="button" class="rail-item" data-surface="roads">ROADS</button>
            <span class="rail-dot" aria-hidden="true">&middot;</span>
            <button type="button" class="rail-item" data-surface="stats">STATS</button>
            <span class="rail-dot" aria-hidden="true">&middot;</span>
            <button type="button" class="rail-item" data-surface="garage">GARAGE</button>
          </div>
          <div class="rail-track" aria-hidden="true"><span class="rail-marker"></span></div>
        </div>
      </div>

      <div class="scrolly-copy">
        {surfaces.map((s, i) => (
          <div class={`scrolly-block${i === 0 ? " is-active" : ""}`} data-surface={s.surface}>
            <p class="eyebrow microlabel">{s.eyebrow}</p>
            <h2>{s.heading}</h2>
            <p class="body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="wrap surfaces-fallback">
      {surfaces.map((s) => (
        <div class="surface-row">
          <div class="surface-copy">
            <p class="eyebrow microlabel">{s.eyebrow}</p>
            <h2>{s.heading}</h2>
            <p class="body">{s.body}</p>
          </div>
          <div class="surface-device">
            <!-- real simulator capture, seeded showcase store (2026-08-22) -->
            <img
              src={s.image.src}
              width={s.image.width}
              height={s.image.height}
              alt={s.alt}
              loading="lazy"
            />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="not-a-scan-tool">
    <div class="wrap">
      <div class="panel not-a-scan-tool__panel">
        <p class="eyebrow microlabel">NOT A SCAN TOOL</p>
        <div class="honesty-line honesty-line--first">
          <p>Reads faults and reports them.</p>
        </div>
        <div class="honesty-line">
          <p>Never clears a code.</p>
        </div>
        <div class="honesty-line">
          <p>Never writes to the car.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hardware">
    <div class="wrap">
      <div class="hardware-copy">
        <p class="eyebrow microlabel">HARDWARE</p>
        <h2>All you need is an adapter.</h2>
        <p class="body">
          Any BLE ELM327 adapter works, about $15. WiFi-only adapters cannot be used.
          Plug it into the OBD2 port, pair once inside the app, and forget
          it is there.
        </p>
      </div>
      <div class="spec-cells">
        <div class="panel spec-cell">
          <p class="microlabel">LINK</p>
          <p class="value">BLE ELM327</p>
        </div>
        <div class="panel spec-cell">
          <p class="microlabel">PROTOCOLS</p>
          <p class="value">CAN + K-line</p>
        </div>
        <div class="panel spec-cell">
          <p class="microlabel">PORT</p>
          <p class="value">OBD2, 1996 on</p>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  .wrap {
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: 120px;
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: 182px 0 0;
    min-height: 844px;
    overflow: clip;
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    padding-left: 120px;
    max-width: 560px;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 62px;
    line-height: 66px;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    max-width: 600px;
  }

  .hero-sub {
    margin-top: 32px;
    font-size: 19px;
    line-height: 30px;
    color: var(--text-secondary);
    max-width: 430px;
  }

  .app-store-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 40px;
    width: 176px;
    height: 52px;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.2em;
    color: rgba(var(--color-bone-rgb), 0.7);
    text-decoration: none;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .hero-trace-box {
    position: absolute;
    left: 43.71%;
    top: 344px;
    width: 55.58%;
    aspect-ratio: 1000 / 504;
  }

  .hero-trace {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  #hero-route-path {
    stroke-dasharray: none;
  }

  .hero-tick {
    opacity: 1;
    transform: none;
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 260ms var(--ease-spring), transform 260ms var(--ease-spring);
  }

  .hero-tick circle {
    fill: none;
    stroke: var(--color-amber);
    stroke-width: 2;
  }

  .hero-tick text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--color-amber);
  }

  .hero-device {
    position: absolute;
    right: 10.14%;
    top: 64px;
    width: 314px;
    max-width: 38%;
    height: auto;
  }

  .telemetry-strip {
    position: absolute;
    left: 120px;
    bottom: 46px;
    z-index: 2;
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--text-faint);
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    width: calc(100% - 240px);
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 48px;
      min-height: 0;
    }

    .hero-copy {
      padding-left: 24px;
      padding-right: 24px;
      max-width: none;
    }

    .hero-headline {
      font-size: 36px;
      line-height: 41px;
      max-width: 330px;
    }

    .hero-sub {
      margin-top: 24px;
      font-size: 15.5px;
      line-height: 24px;
      max-width: 310px;
    }

    .app-store-badge {
      width: 160px;
      height: 48px;
      margin-top: 32px;
    }

    .hero-visual {
      position: relative;
      inset: auto;
      margin-top: 40px;
      min-height: 600px;
    }

    .hero-device {
      position: relative;
      display: block;
      margin: 0 auto;
      right: auto;
      top: auto;
      width: 241px;
      max-width: 62%;
    }

    .hero-trace-box {
      left: 3.1%;
      top: 388px;
      width: 92.3%;
    }

    .telemetry-strip {
      position: relative;
      left: auto;
      bottom: auto;
      margin-top: 56px;
      padding: 24px 24px 0;
      width: 100%;
    }
  }

  /* ---------- Interstitial ---------- */
  .interstitial-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    padding: 170px 24px 180px;
    text-align: center;
  }

  .interstitial-heading {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 44px;
    line-height: 52px;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .interstitial-copy {
      gap: 16px;
      padding: 120px 24px 130px;
    }

    .interstitial-heading {
      font-size: 30px;
      line-height: 38px;
      max-width: 310px;
    }
  }

  /* ---------- Surfaces ---------- */
  .surfaces {
    padding-block: 130px;
  }

  /* Enhancement default: hidden until JS confirms motion + IntersectionObserver
     + position:sticky are all available (see page script). No-JS, reduced
     motion, and unsupported browsers keep .surfaces-fallback fully visible. */
  .surfaces-scrolly {
    display: none;
  }

  html.scrolly-active .surfaces-fallback {
    display: none;
  }

  html.scrolly-active .surfaces-scrolly {
    display: flex;
  }

  /* Pinned device is the first DOM child, copy the second, so a plain
     flex-direction flip (row-reverse on desktop, column on mobile) places
     each where the frame puts it without any JS re-parenting. */
  .surfaces-scrolly {
    flex-direction: row-reverse;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
  }

  .scrolly-copy {
    display: flex;
    flex-direction: column;
    width: 460px;
    flex-shrink: 0;
  }

  .scrolly-block {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-height: 72vh;
    justify-content: center;
    opacity: 0.25;
    transition: opacity 500ms var(--ease-spring);
  }

  .scrolly-block:first-child,
  .scrolly-block:last-child {
    min-height: 58vh;
  }

  .scrolly-block.is-active {
    opacity: 1;
  }

  .scrolly-block h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 32px;
    line-height: 38px;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .scrolly-block .body {
    font-size: 16px;
    line-height: 26px;
    color: rgba(var(--color-bone-rgb), 0.6);
    max-width: 440px;
  }

  .scrolly-pinned {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    flex-shrink: 0;
    position: sticky;
    top: 140px;
  }

  .scrolly-device {
    position: relative;
    width: 271px;
    height: 564px;
    border-radius: 34px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #0b0b0c;
    overflow: hidden;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
  }

  /* Hard cut, no transition: the motion grammar bans cross-fades here. All
     four screens render at once (not swapped via one img's src) so decode
     already happened before the first cut — nothing to flicker. */
  .scrolly-screen {
    position: absolute;
    inset: 10px;
    width: calc(100% - 20px);
    height: calc(100% - 20px);
    border-radius: 26px;
    object-fit: cover;
    object-position: top center;
    opacity: 0;
  }

  .scrolly-screen.is-active {
    opacity: 1;
  }

  .scrolly-rail {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rail-labels {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10px;
    letter-spacing: 2.4px;
    white-space: nowrap;
  }

  .rail-item {
    appearance: none;
    background: none;
    border: none;
    margin: 0;
    padding: 0;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
    color: rgba(var(--color-bone-rgb), 0.35);
    transition: color 260ms var(--ease-spring);
  }

  .rail-item:hover {
    color: var(--text-primary);
  }

  .rail-item.is-active {
    color: var(--color-amber);
  }

  .rail-dot {
    color: rgba(var(--color-bone-rgb), 0.2);
  }

  .rail-track {
    position: relative;
    height: 2px;
    width: 100%;
  }

  /* The marker's slide may animate (it is a position change, not a fade). */
  .rail-marker {
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background: var(--color-amber);
    transition: left 400ms var(--ease-spring), width 400ms var(--ease-spring);
  }

  @media (max-width: 860px) {
    .surfaces-scrolly {
      flex-direction: column;
      align-items: center;
      gap: 0;
    }

    .scrolly-pinned {
      position: sticky;
      top: 0;
      z-index: 1;
      width: 100%;
      padding-top: 22px;
      padding-bottom: 24px;
      background: var(--color-ground);
      gap: 14px;
    }

    .scrolly-device {
      width: 241px;
      height: 496px;
      border-radius: 32px;
      margin-inline: auto;
    }

    .scrolly-screen {
      inset: 11px;
      width: calc(100% - 22px);
      height: calc(100% - 22px);
      border-radius: 24px;
    }

    .scrolly-rail {
      gap: 5px;
    }

    .rail-labels {
      font-size: 9px;
      gap: 8px;
      letter-spacing: 2px;
      justify-content: center;
    }

    .scrolly-copy {
      width: 100%;
      gap: 56px;
      padding-top: 48px;
    }

    /* The device is only sticky at the top (~55vh incl. rail) on mobile, not
       pinned beside the copy for its full scroll — so blocks need less
       runway than desktop's 72vh to still feel like one focus per block. */
    .scrolly-block {
      min-height: 60vh;
      gap: 12px;
    }

    .scrolly-block:first-child,
    .scrolly-block:last-child {
      min-height: 46vh;
    }

    .scrolly-block h2 {
      font-size: 26px;
      line-height: 31px;
      max-width: 342px;
    }

    .scrolly-block .body {
      font-size: 15px;
      line-height: 24px;
      max-width: 342px;
    }
  }

  .surface-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
  }

  .surface-row + .surface-row {
    margin-top: 130px;
  }

  .surface-row:nth-child(even) {
    flex-direction: row-reverse;
  }

  .surface-copy {
    max-width: 460px;
  }

  .eyebrow {
    color: var(--color-amber);
    font-size: 10px;
    letter-spacing: 0.24em;
  }

  .surface-copy h2,
  .hardware-copy h2 {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 32px;
    line-height: 38px;
    letter-spacing: -0.015em;
    color: var(--text-primary);
  }

  .surface-copy .body,
  .hardware-copy .body {
    margin-top: 16px;
    font-size: 16px;
    line-height: 26px;
    color: var(--text-secondary);
    max-width: 440px;
  }

  .surface-device img {
    display: block;
    width: 271px;
    max-width: 100%;
    height: auto;
    opacity: 1;
    transform: none;
  }

  @media (max-width: 860px) {
    .wrap {
      padding-inline: 24px;
    }

    .surfaces {
      padding-block: 80px;
    }

    .surface-row,
    .surface-row:nth-child(even) {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }

    .surface-row + .surface-row {
      margin-top: 90px;
    }

    .surface-device {
      align-self: center;
    }

    .surface-device img {
      width: 241px;
    }
  }

  /* Row entrance, JS-driven (IntersectionObserver in the page script) so it
     works in every browser, not just ones with animation-timeline: view().
     Baseline above is already fully visible/static — .row-pending is only
     ever added by JS, so a script failure leaves rows visible, not blank. */
  .surface-row.row-pending {
    opacity: 0;
    transform: translateY(28px);
  }

  .surface-row.is-in {
    animation: row-in 700ms var(--ease-spring) both;
  }

  @keyframes row-in {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ---------- Not a scan tool ---------- */
  .not-a-scan-tool {
    padding-bottom: 150px;
  }

  .not-a-scan-tool .not-a-scan-tool__panel {
    padding: 48px 56px;
    border-radius: 16px;
  }

  .honesty-line {
    padding-block: 26px;
    border-top: 1px solid var(--panel-hairline);
  }

  .honesty-line--first {
    border-top: none;
    padding-top: 24px;
  }

  .honesty-line p {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.015em;
    color: var(--text-secondary);
  }

  .honesty-line--first p {
    color: var(--text-primary);
  }

  .not-a-scan-tool .eyebrow {
    margin-bottom: 24px;
    display: block;
  }

  @media (max-width: 860px) {
    .not-a-scan-tool {
      padding-bottom: 90px;
    }

    .not-a-scan-tool .not-a-scan-tool__panel {
      padding: 32px 26px;
    }

    .honesty-line p {
      font-size: 19px;
    }
  }

  /* ---------- Hardware ---------- */
  .hardware {
    padding-bottom: 150px;
  }

  .hardware .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
  }

  .hardware-copy {
    max-width: 460px;
    flex-shrink: 0;
  }

  .spec-cells {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 604px;
