---
import Base from "../layouts/Base.astro";
import SampleDrive from "../components/SampleDrive.astro";
import { withBase } from "../lib/base";

const image = (name: string) => withBase(`/images/living-cartography/${name}`);
const steps = [
  ["Connect the adapter", "Plug it into your car’s OBD2 port."],
  ["Pair with AutoLog", "While parked, open AutoLog and connect to the adapter."],
  ["Choose your readings", "While parked, choose which readings appear during a drive. Available readings vary by car."],
];
---

<Base title="AutoLog" description="AutoLog records your drives so you can look back at the routes you took." home>
  <SampleDrive />

  <section class="history" aria-labelledby="history-title">
    <div class="content history__layout">
      <div class="history__intro">
        <h2 id="history-title">Drive history by car</h2>
        <p>AutoLog keeps a separate history for each car. These two drives belong to the same Miata.</p>
      </div>
      <div class="landscape" aria-hidden="true">
        <img class="landscape__world" src={image("countryside.webp")} width="393" height="295" alt="" loading="lazy" />
        <img class="landscape__car" src={image("miata.png")} width="357" height="238" alt="" loading="lazy" />
      </div>
      <div class="history__entries">
        <dl>
          <div><dt>Sunday detour</dt><dd>11.6 mi&nbsp; · &nbsp;27 min</dd></div>
          <div><dt>Monday commute</dt><dd>8.4 mi&nbsp; · &nbsp;18 min</dd></div>
        </dl>
        <p>Sample entries</p>
      </div>
    </div>
  </section>

  <section id="setup" class="content setup" aria-labelledby="setup-title">
    <div class="setup__copy">
      <h2 id="setup-title">Connecting your car</h2>
      <p class="setup__intro">You’ll need an iPhone and a compatible Bluetooth Low Energy (BLE) OBD2 adapter.</p>
      <ol class="steps" role="list">
        {steps.map(([title, body], index) => (
          <li>
            <span class="step-number" aria-hidden="true">{index + 1}</span>
            <div><h3>{title}</h3><p>{body}</p></div>
          </li>
        ))}
      </ol>
      <a class="compatibility" href={withBase("/support")}>Check adapter compatibility →</a>
    </div>
    <figure class="parked">
      <img src={image("recording.webp")} width="393" height="852" alt="AutoLog recording screen showing 18.4 miles, 36:12 elapsed, and 29.6 mpg average while safely parked." loading="lazy" />
      <figcaption>
        <span class="parked__desktop-caption">Example of the parked display</span>
        <span class="parked__mobile-caption">
          <span class="parked__title">Parked display</span>
          <span>This example shows distance, elapsed time, and average fuel economy.</span>
        </span>
      </figcaption>
    </figure>
  </section>
</Base>

<style>
  .content {
    width: min(87.5%, 1260px);
    margin-inline: auto;
  }

  .history,
  .parked {
    background: #e6ebdd;
  }

  .history__layout {
    display: grid;
    grid-template-columns: minmax(0, 638fr) minmax(0, 537fr);
    grid-template-rows: auto 1fr;
    column-gap: 6.75%;
    padding-block: 42px;
  }

  .history__intro,
  .history__entries {
    grid-column: 2;
  }

  .history__intro {
    padding-top: 26px;
  }

  .history__intro h2,
  .setup h2 {
    font-size: 3.0625rem;
    line-height: 1.14;
  }

  .history__intro p {
    max-width: 475px;
    margin-top: 11px;
    font-size: 1.1875rem;
    line-height: 1.475;
  }

  .landscape {
    position: relative;
    grid-area: 1 / 1 / span 2 / 2;
    align-self: center;
    overflow: hidden;
    aspect-ratio: 638 / 428;
    border-radius: 12px;
  }

  .landscape img {
    position: absolute;
  }

  .landscape__world {
    top: -7.94%;
    width: 100%;
  }

  .landscape__car {
    top: 37.38%;
    left: 43.42%;
    width: 58%;
  }

  .history__entries {
    width: min(100%, 511px);
    margin-top: 57px;
  }

  .history__entries dl,
  .history__entries dd {
    margin: 0;
  }

  .history__entries dl > div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 2px 8px;
    min-height: 67px;
    padding-block: 12px;
    border-top: 1px solid var(--rule);
  }

  .history__entries dt {
    font-size: 1.3125rem;
    font-weight: 500;
  }

  .history__entries dd {
    font-size: 1.125rem;
  }

  .history__entries p,
  .step-number,
  .parked__desktop-caption {
    color: #52665b;
  }

  .history__entries p {
    margin-top: 8px;
    font-size: .875rem;
  }

  .setup {
    display: grid;
    grid-template-columns: minmax(0, 590fr) minmax(0, 546fr);
    align-items: start;
    gap: 9.76%;
    padding-block: 55px 59px;
  }

  .setup__copy {
    padding-top: 16px;
  }

  .setup h2 {
    font-size: 3.125rem;
  }

  .setup__intro {
    max-width: 562px;
    margin-top: 22px;
    font-size: 1.25rem;
    line-height: 1.5;
  }

  .steps {
    margin: 53px 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    min-height: 92px;
    padding-top: 9px;
    border-top: 1px solid var(--rule);
  }

  .step-number {
    padding-top: 3px;
    font-size: 1.1875rem;
    font-weight: 500;
  }

  .steps h3 {
    font: 500 1.375rem/1.32 var(--font-body);
  }

  .steps p {
    margin-top: 5px;
    font-size: 1.0625rem;
    line-height: 1.412;
  }

  .compatibility {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 42px;
    font-weight: 500;
    text-decoration: none;
  }

  .compatibility:hover {
    text-decoration: underline;
  }

  .parked {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
    padding: 31px 16px 32px;
    border-radius: 14px;
    text-align: center;
  }

  .parked img {
    width: min(216px, 82%);
  }

  .parked figcaption {
    margin-top: 22px;
    font-size: 1.0625rem;
    line-height: 1.53;
  }

  .parked__mobile-caption {
    display: none;
  }

  @media (max-width: 860px) {
    .content {
      width: min(calc(100% - 40px), 634px);
    }

    .history__layout,
    .setup {
      display: flex;
      flex-direction: column;
    }

    .history__layout {
      padding-block: 32px 37px;
    }

    .history__intro,
    .setup__copy {
      padding-top: 0;
    }

    .history__intro h2,
    .setup h2 {
      font-size: 2.1875rem;
      line-height: 1.2;
    }

    .history__intro p,
    .setup__intro {
      max-width: none;
      margin-top: 9px;
      font-size: 1rem;
      line-height: 1.4375;
    }

    .history__intro {
      min-height: 120px;
    }

    .landscape {
      width: 100%;
      aspect-ratio: 350 / 177;
      margin-top: 17px;
    }

    .landscape__world {
      top: -31.64%;
    }

    .landscape__car {
      top: 34.46%;
      left: 42.28%;
      width: 59.14%;
    }

    .history__entries {
      width: 100%;
      margin-top: 25px;
    }

    .history__entries dl > div {
      min-height: 58px;
    }

    .history__entries dt {
      font-size: 1.0625rem;
    }

    .history__entries dd {
      font-size: .9375rem;
    }

    .history__entries p {
      margin-top: 12px;
      font-size: .8125rem;
    }

    .setup {
      gap: 36px;
      padding-block: 34px 38px;
    }

    .steps {
      margin-top: 38px;
    }

    .steps li {
      min-height: 86px;
      padding-bottom: 20px;
    }

    .step-number {
      font-size: 1rem;
    }

    .steps h3 {
      font-size: 1.125rem;
    }

    .steps p {
      margin-top: 3px;
      font-size: .9375rem;
      line-height: 1.3334;
    }

    .compatibility {
      margin-top: 24px;
    }

    .parked {
      display: grid;
      grid-template-columns: minmax(0, 115px) minmax(0, 181px);
      justify-content: center;
      align-items: center;
      align-self: stretch;
      gap: 17px;
      padding: 17px 23px 17px 14px;
      text-align: left;
    }

    .parked img {
      width: 100%;
    }

    .parked figcaption {
      margin: 0;
      font-size: .9375rem;
      line-height: 1.4;
    }

    .parked__desktop-caption {
      display: none;
    }

    .parked__mobile-caption {
      display: block;
    }

    .parked__title {
      display: block;
      margin-bottom: 10px;
      font: 400 1.5rem/1.2 var(--font-heading);
    }
  }
</style>
