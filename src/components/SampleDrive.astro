---
import { withBase } from "../lib/base";

const drives = [
  {
    day: "monday",
    label: "Monday commute",
    heading: "Monday’s route",
    recap: "The car took the direct route from town to home.",
    distance: "8.4 mi",
    time: "18 min",
    mapDescription: "Map of Monday’s direct route from town to home, crossing the Alder River.",
  },
  {
    day: "sunday",
    label: "Sunday detour",
    heading: "Sunday’s route",
    recap: "The detour along the Alder River added 3.2 miles to the drive home.",
    distance: "11.6 mi",
    time: "27 min",
    mapDescription: "Map of Sunday’s detour along the Alder River, with Monday’s direct route shown as a dashed line.",
  },
];
---

<section class="sample" id="the-app" aria-labelledby="sample-title">
  <div class="sample-intro">
    <p class="eyebrow">Sample drive</p>
    <h1 id="sample-title">Compare two drives</h1>
    <p class="introduction">AutoLog records your drives so you can look back at the routes you took.</p>
    <p class="instruction" id="drive-instruction">Select a day to see the route and drive time.</p>
    <fieldset aria-describedby="drive-instruction">
      <legend class="visually-hidden">Choose a drive</legend>
      <div class="options">
        {drives.map(({ day, label }) => (
          <label>
            <input type="radio" name="sample-drive" value={day} checked={day === "monday"} aria-controls={`map-${day} recap-${day}`} />
            <span>{label}</span>
          </label>
        ))}
      </div>
    </fieldset>
  </div>
  <div class="maps">
    {drives.map(({ day, mapDescription }) => (
      <img id={`map-${day}`} data-day={day} src={withBase(`/images/sample-drive/${day}.svg`)} width="350" height="258" alt={mapDescription} />
    ))}
  </div>
  <div class="summary" aria-live="polite" aria-atomic="true">
    {drives.map(({ day, heading, recap, distance, time }) => (
      <section id={`recap-${day}`} data-day={day} aria-labelledby={`title-${day}`}>
        <h2 id={`title-${day}`}>{heading}</h2>
        <p class="recap">{recap}</p>
        <dl>
          <div><dt>Distance</dt><dd>{distance}</dd></div>
          <div><dt>Drive time</dt><dd>{time}</dd></div>
        </dl>
      </section>
    ))}
  </div>
  <div class="vehicle">
    <img src={withBase("/images/living-cartography/miata.png")} width="94" height="63" alt="" />
    <div>
      <p class="vehicle-name">Mazda MX-5 Miata</p>
      <p class="vehicle-note">Illustrative drive history</p>
    </div>
  </div>
</section>

<style>
  .sample {
    display: grid;
    grid-template-columns: minmax(0, 540fr) minmax(0, 634fr);
    grid-template-rows: max-content 1fr;
    column-gap: min(5.9722vw, 86px);
    align-items: start;
    align-content: start;
    width: min(87.5%, 1260px);
    min-height: 654px;
    margin-inline: auto;
    padding-block: 32px 44px;
    overflow-wrap: anywhere;
  }

  .sample-intro { grid-area: 1 / 1; }
  .eyebrow, dt, .vehicle-note { color: #52665b; }
  .eyebrow, dt, .vehicle-name { font-weight: 500; }
  .eyebrow { font-size: 1rem; line-height: 1.375; }
  h1 {
    width: calc(100% + min(5.9722vw, 86px));
    margin-block: 13px 14px;
    font-size: clamp(2.5rem, 4.7222vw, 4.25rem);
    line-height: 1.118;
  }
  .introduction {
    max-width: 520px;
    font-size: 1.3125rem;
    line-height: 1.42857;
  }
  .instruction {
    margin-block: 20px 16px;
    font-size: 1.0625rem;
    line-height: 1.29412;
  }
  fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2px;
    width: min(100%, 350px);
    padding: 4px;
    border-radius: 12px;
    background: #dee3d6;
  }
  .options label { position: relative; display: flex; }
  .options input {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .options span {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 44px;
    padding: 4px;
    border-radius: 9px;
    font-size: .9375rem;
    font-weight: 500;
    line-height: 1.33;
    text-align: center;
  }
  .options input:checked + span { background: var(--ink); color: var(--paper); }
  .options input:focus-visible + span {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--paper);
  }
  [data-day="sunday"],
  .sample:has(input[value="sunday"]:checked) [data-day="monday"] { display: none; }
  .sample:has(input[value="sunday"]:checked) [data-day="sunday"] { display: block; }
  .maps {
    grid-area: 1 / 2 / 3 / 3;
    margin-top: 42px;
  }
  .maps img { width: 100%; border-radius: 4% / 5.43%; }
  .summary { grid-area: 2 / 1; margin-top: 49px; }
  h2, dd { font-size: 2.375rem; line-height: 1.21; }
  .recap {
    margin-top: 5px;
    min-height: 2lh;
    font-size: 1.125rem;
    line-height: 1.33333;
  }
  dl {
    display: grid;
    grid-template-columns: minmax(0, 236fr) minmax(0, 274fr);
    max-width: 510px;
    margin: 15px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }
  dt { font-size: .9375rem; line-height: 1.4; }
  dd { margin: 5px 0 0; font-family: var(--font-heading); }
  .vehicle {
    grid-area: 1 / 2 / 3 / 3;
    display: flex;
    align-items: center;
    gap: 19px;
    min-width: 0;
    /* Both maps are 350 × 258 at every viewport width. */
    margin-top: calc(42px + 100% * 258 / 350);
    padding: 6px 0 0 10px;
  }
  .vehicle img { width: 94px; flex: none; }
  .vehicle-name { font-size: 1.0625rem; line-height: 1.35; }
  .vehicle-note { margin-top: 1px; font-size: .875rem; line-height: 1.43; }

  @media (max-width: 860px) {
    .sample {
      display: block;
      width: min(calc(100% - 40px), 634px);
      min-height: 0;
      padding-block: 17px 14px;
    }
    .eyebrow { font-size: .8125rem; line-height: 1.30769; }
    h1 { width: auto; margin-block: 7px; font-size: 2.5rem; line-height: 1.125; }
    .introduction { font-size: 1rem; line-height: 1.375; }
    .instruction { margin-block: 16px 12px; font-size: .9375rem; line-height: 1.33333; }
    .maps { margin-top: 15px; }
    .summary { margin-top: 24px; }
    h2 { font-size: 2.0625rem; line-height: 1.15152; }
    .recap { margin-top: 3px; font-size: .9375rem; line-height: 1.33333; }
    dl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 20px;
      max-width: none;
      margin-top: 4px;
    }
    dt { font-size: .8125rem; line-height: 1.38462; }
    dd { margin-top: 7px; font-size: 1.9375rem; line-height: 1.22581; }
    .vehicle {
      gap: 14px;
      margin-top: 13px;
      padding: 10px 0 0;
      border-top: 1px solid var(--rule);
    }
    .vehicle img { width: 80px; margin-left: -2px; }
    .vehicle-name { font-size: 1rem; line-height: 1.375; }
    .vehicle-note { margin-top: 0; font-size: .8125rem; }
  }

  @media (forced-colors: active) {
    .options input:checked + span { outline: 2px solid Highlight; outline-offset: -2px; }
    .options input:focus-visible + span { outline: 3px double CanvasText; outline-offset: 1px; }
  }
</style>
