---
import "../styles/global.css";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const newsreader = withBase("/fonts/Newsreader-Regular.woff2");
const dmSans = withBase("/fonts/DMSans-Regular.woff2");
const brand = withBase("/fonts/BricolageGrotesque-Medium.woff2");
const fontFaces = [
  ["Newsreader", newsreader, 400],
  ["DM Sans", dmSans, 400],
  ["Bricolage Grotesque", brand, 500],
]
  .map(
    ([family, url, weight]) =>
      `@font-face{font-family:'${family}';src:url('${url}') format('woff2');font-weight:${weight};font-style:normal;font-display:swap}`,
  )
  .join("\n");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    <style is:inline set:html={fontFaces} />
  </head>
  <body>
    <header class="site-header">
      <a class="site-wordmark" href={withBase("/")}>AutoLog</a>
      <nav class="desktop-nav" aria-label="Primary">
        <a href={withBase("/#the-app")}>The app</a>
        <a href={withBase("/support")}>Support</a>
        <span>A new chapter, coming soon</span>
      </nav>
      <a
        class="mobile-nav-link"
        href={home ? withBase("/#the-app") : withBase("/")}
      >{home ? "The app ↓" : "Back to app"}</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <a class="site-footer__wordmark" href={withBase("/")}>AutoLog</a>
      <p class="site-footer__line">Your drives. Your cars. Your story.</p>
      <nav class="site-footer__links" aria-label="Footer">
        <a href={withBase("/support")}>Support</a>
        <a href={withBase("/privacy")}>Privacy</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 96px;
    padding: 20px 80px;
  }

  .site-wordmark,
  .site-footer__wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-brand);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  .site-wordmark {
    min-width: 180px;
    font-size: 32px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .desktop-nav a,
  .desktop-nav span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    text-decoration: none;
  }

  .desktop-nav span {
    width: 200px;
    font-size: 14px;
  }

  .mobile-nav-link {
    display: none;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 190px 1fr 180px;
    align-items: center;
    min-height: 144px;
    padding: 28px 80px;
  }

  .site-footer__wordmark {
    font-size: 30px;
  }

  .site-footer__line {
    justify-self: center;
    width: 410px;
    font-size: 16px;
  }

  .site-footer__links {
    display: flex;
    gap: 36px;
    font-size: 15px;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .site-header {
      min-height: 76px;
      padding: 16px 24px;
    }

    .site-wordmark {
      min-width: 148px;
      font-size: 26px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-nav-link {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      min-width: 84px;
      min-height: 44px;
      font-size: 14px;
      text-decoration: none;
    }

    .site-footer {
      display: flex;
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 28px 24px 44px;
    }

    .site-footer__wordmark {
      font-size: 25px;
    }

    .site-footer__line {
      display: none;
    }

    .site-footer__links {
      gap: 30px;
      font-size: 14px;
    }
  }
</style>
