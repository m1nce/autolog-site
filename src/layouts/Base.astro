---
import "../styles/global.css";
import { withBase } from "../lib/base";

interface Props {
  title: string;
  description: string;
  home?: boolean;
}

const { title, description, home = false } = Astro.props;
const newsreader = withBase("/fonts/Newsreader-Regular.woff2");
const dmSans = withBase("/fonts/DMSans-Regular.woff2");
const brand = withBase("/fonts/BricolageGrotesque-Medium.woff2");
const logo = withBase("/images/brand/autolog-symbol.svg");
const fontFaces = [
  ["Newsreader", newsreader, 400],
  ["DM Sans", dmSans, 400],
  ["Bricolage Grotesque", brand, 500],
  ...(home ? [["DM Sans", withBase("/fonts/DMSans-Medium.ttf"), 500, "truetype"]] : []),
]
  .map(
    ([family, url, weight, format = "woff2"]) =>
      `@font-face{font-family:'${family}';src:url('${url}') format('${format}');font-weight:${weight};font-style:normal;font-display:swap}`,
  )
  .join("\n");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <title>{title}</title>
    <style is:inline set:html={fontFaces} />
  </head>
  <body>
    <header class:list={["site-header", { "home-header": home }]}>
      <a class="site-wordmark" href={withBase("/")}><img src={logo} width="44" height="44" alt="" />AutoLog</a>
      {home ? (
        <nav class="home-header__nav" aria-label="Primary">
          <a href="#setup">Setup</a>
          <a class="home-header__support" href={withBase("/support")}>Support</a>
        </nav>
      ) : (
        <>
          <nav class="desktop-nav" aria-label="Primary">
            <a href={withBase("/#the-app")}>The app</a>
            <a href={withBase("/support")}>Support</a>
            <span>A new chapter, coming soon</span>
          </nav>
          <a class="mobile-nav-link" href={withBase("/")}>Back to app</a>
        </>
      )}
    </header>

    <main>
      <slot />
    </main>

    <footer class:list={["site-footer", { "home-footer": home }]}>
      <a class="site-footer__wordmark" href={withBase("/")}><img src={logo} width="44" height="44" alt="" />AutoLog</a>
      {!home && <p class="site-footer__line">Your drives. Your cars. Your story.</p>}
      <nav class="site-footer__links" aria-label="Footer">
        <a href={withBase("/support")}>Support</a>
        <a href={withBase("/privacy")}>Privacy</a>
      </nav>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 96px;
    padding: 20px 80px;
  }

  .site-wordmark,
  .site-footer__wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-family: var(--font-brand);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  .site-wordmark {
    min-width: 180px;
    font-size: 32px;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 34px;
  }

  .desktop-nav a,
  .desktop-nav span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
    text-decoration: none;
  }

  .desktop-nav span {
    width: 200px;
    font-size: 14px;
  }

  .mobile-nav-link {
    display: none;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 190px 1fr 180px;
    align-items: center;
    min-height: 144px;
    padding: 28px 80px;
  }

  .site-footer__wordmark {
    font-size: 30px;
  }

  .site-footer__line {
    justify-self: center;
    width: 410px;
    font-size: 16px;
  }

  .site-footer__links {
    display: flex;
    gap: 36px;
    font-size: 15px;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .site-header {
      min-height: 76px;
      padding: 16px 24px;
    }

    .site-wordmark {
      min-width: 148px;
      font-size: 26px;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-nav-link {
      display: inline-flex;
      align-items: center;
      justify-content: flex-end;
      min-width: 84px;
      min-height: 44px;
      font-size: 14px;
      text-decoration: none;
    }

    .site-footer {
      display: flex;
      min-height: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding: 28px 24px 44px;
    }

    .site-footer__wordmark {
      font-size: 25px;
    }

    .site-footer__line {
      display: none;
    }

    .site-footer__links {
      gap: 30px;
      font-size: 14px;
    }
  }

  .home-header,
  .home-footer {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: min(87.5%, 1260px);
    margin-inline: auto;
    padding: 0;
    gap: 12px;
  }

  .home-header {
    min-height: 78px;
    border-bottom: 1px solid var(--rule);
  }

  .home-header .site-wordmark,
  .home-footer .site-footer__wordmark {
    min-width: 0;
    gap: 5px;
    font-size: 1.6875rem;
  }

  .home-header .site-wordmark {
    margin-left: -4px;
  }

  .home-header img,
  .home-footer img {
    width: 39px;
  }

  .home-header__nav,
  .home-footer .site-footer__links {
    display: flex;
    align-items: center;
    font-size: 1rem;
    font-weight: 500;
  }

  .home-header__nav {
    gap: 50px;
    margin-right: 42px;
  }

  .home-header__nav a,
  .home-footer .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
  }

  .home-header__nav a {
    min-width: 66px;
  }

  .home-header__nav .home-header__support {
    min-width: 88px;
  }

  .home-header__nav a:hover,
  .home-footer .site-footer__links a:hover {
    text-decoration: underline;
  }

  .home-footer {
    min-height: 116px;
    border-top: 1px solid var(--rule);
    padding-bottom: 8px;
  }

  .home-footer .site-footer__links {
    gap: 60px;
  }

  .home-footer .site-footer__links a {
    min-width: 80px;
  }

  @media (max-width: 860px) {
    .home-header,
    .home-footer {
      width: min(calc(100% - 40px), 634px);
    }

    .home-header {
      min-height: 60px;
      padding-bottom: 4px;
    }

    .home-footer {
      min-height: 94px;
      padding-bottom: 4px;
    }

    .home-header .site-wordmark,
    .home-footer .site-footer__wordmark {
      gap: 4px;
      font-size: 1.4375rem;
    }

    .home-header img,
    .home-footer img {
      width: 32px;
    }

    .home-header__nav,
    .home-footer .site-footer__links {
      margin-right: 0;
      font-size: .875rem;
    }

    .home-header__nav .home-header__support {
      display: none;
    }

    .home-header__nav a {
      min-width: 51px;
    }

    .home-footer .site-footer__links {
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0 min(10vw, 40px);
    }

    .home-footer .site-footer__links a {
      min-width: 54px;
    }
  }
</style>
